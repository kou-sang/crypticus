rules_version = '2';

// Principio: el cliente solo escribe lo que no afecta la puntuación.
// Puntajes, inicio/fin de partidas y rating se escriben con Admin SDK (Vercel Functions),
// que ignora estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function validText(text) { return text is string && text.size() > 0 && text.size() <= 500; }

    // ---------- Usuarios ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'handle', 'rating', 'stats', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.rating == 1200
        && request.resource.data.stats == { 'played': 0, 'wins': 0, 'solved': 0, 'hintsUsed': 0 }
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32
        && existsAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle));
      allow update: if isUser(uid)
        && onlyChanged(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32;
      allow delete: if false;
    }

    // Unicidad de @handle: el id del doc es el handle.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- Cripticos ----------
    match /cryptics/{crypticId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /crypticSecrets/{crypticId} {
      allow read, write: if false;
    }

    // ---------- Competencias ----------
    match /competitions/{competitionId} {
      function comp() { return resource.data; }
      function next() { return request.resource.data; }

      allow read: if signedIn();

      allow create: if signedIn()
        && next().hostId == request.auth.uid
        && next().status == 'lobby'
        && next().participantIds == [request.auth.uid]
        && next().crypticIds is list
        && next().crypticIds.size() >= 1
        && next().crypticIds.size() <= 50
        && next().maxPlayers is int
        && next().maxPlayers >= 2
        && next().maxPlayers <= 50
        && next().mode in ['timed', 'count']
        && next().scoring in ['standard', 'fewestHints', 'speed', 'winByTwo']
        && next().visibility in ['public', 'friends', 'private']
        && next().title is string && next().title.size() >= 3 && next().title.size() <= 60
        && next().startedAt == null && next().endsAt == null
        && next().finishedAt == null && next().winnerId == null;

      // Unirse / salir del lobby: solo se modifica participantIds con el propio uid.
      allow update: if signedIn()
        && comp().status == 'lobby'
        && onlyChanged(['participantIds'])
        && (
          (next().participantIds == comp().participantIds.concat([request.auth.uid])
            && !(request.auth.uid in comp().participantIds)
            && comp().participantIds.size() < comp().maxPlayers)
          ||
          (request.auth.uid in comp().participantIds
            && request.auth.uid != comp().hostId
            && next().participantIds.toSet() == comp().participantIds.toSet().difference([request.auth.uid].toSet())
            && next().participantIds.size() == comp().participantIds.size() - 1)
        );

      allow delete: if isUser(comp().hostId) && comp().status == 'lobby';

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if isUser(uid)
          && request.auth.uid in getAfter(/databases/$(database)/documents/competitions/$(competitionId)).data.participantIds
          && request.resource.data.score == 0
          && request.resource.data.solvedIds == []
          && request.resource.data.hintsUsed == 0
          && request.resource.data.attempts == 0;
        // Salir del lobby, o borrar la competencia entera (anfitrión) en el mismo batch.
        allow delete: if isUser(uid)
          && (!existsAfter(/databases/$(database)/documents/competitions/$(competitionId))
              || !(request.auth.uid in getAfter(/databases/$(database)/documents/competitions/$(competitionId)).data.participantIds));
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.text)
          && request.auth.uid in get(/databases/$(database)/documents/competitions/$(competitionId)).data.participantIds;
        allow update, delete: if false;
      }
    }

    // ---------- Amistades ----------
    // id = pairId(a, b). status: pending -> accepted.
    match /friendRequests/{requestId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && requestId == pairId(request.resource.data.from, request.resource.data.to)
        && request.resource.data.status == 'pending'
        && request.resource.data.members.toSet() == [request.resource.data.from, request.resource.data.to].toSet()
        && request.resource.data.members.size() == 2;
      allow update: if isUser(resource.data.to)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && onlyChanged(['status', 'acceptedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---------- Chat ----------
    // chatId = 'global' o pairId de dos amigos.
    match /chats/{chatId}/messages/{messageId} {
      function canAccess() {
        return chatId == 'global'
          || (request.auth.uid in chatId.split('_')
              && get(/databases/$(database)/documents/friendRequests/$(chatId)).data.status == 'accepted');
      }
      allow read: if signedIn() && canAccess();
      allow create: if signedIn() && canAccess()
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.text);
      allow update, delete: if false;
    }
  }
}
