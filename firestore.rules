rules_version = '2';

// Principio: el cliente solo escribe lo que no afecta la puntuación.
// Puntajes, inicio/fin de partidas y rating se escriben con Admin SDK (Vercel Functions),
// que ignora estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function validText(text) { return text is string && text.size() > 0 && text.size() <= 500; }

    // ---------- Usuarios ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'handle', 'stats', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.stats == { 'played': 0, 'wins': 0, 'solved': 0, 'hintsUsed': 0 }
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32
        && existsAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle));
      allow update: if isUser(uid)
        && onlyChanged(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32;
      allow delete: if false;
    }

    // Historial de partidas y rating: lo escribe el servidor al terminar cada partida.
    match /users/{uid}/history/{competitionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Unicidad de @handle: el id del doc es el handle.
    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- Cripticos ----------
    match /cryptics/{crypticId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /crypticSecrets/{crypticId} {
      allow read, write: if false;
    }

    // ---------- Competencias ----------
    match /competitions/{competitionId} {
      function comp() { return resource.data; }
      function next() { return request.resource.data; }

      allow read: if signedIn();

      // Las salas se crean y editan en el Worker (POST/PATCH /api/competitions), que valida las reglas.
      allow create: if false;

      // Unirse / salir del lobby: solo se modifica participantIds con el propio uid.
      allow update: if signedIn()
        && comp().status == 'lobby'
        && onlyChanged(['participantIds'])
        && (
          (next().participantIds == comp().participantIds.concat([request.auth.uid])
            && !(request.auth.uid in comp().participantIds)
            && comp().participantIds.size() < comp().maxPlayers)
          ||
          (request.auth.uid in comp().participantIds
            && request.auth.uid != comp().hostId
            && next().participantIds.toSet() == comp().participantIds.toSet().difference([request.auth.uid].toSet())
            && next().participantIds.size() == comp().participantIds.size() - 1)
        );

      // Duel 2 vs 2: cada jugador elige su equipo en la sala (solo su propia entrada, 0 o 1).
      allow update: if signedIn()
        && comp().status == 'lobby'
        && request.auth.uid in comp().participantIds
        && onlyChanged(['teams'])
        && next().teams.diff(comp().get('teams', {})).affectedKeys().hasOnly([request.auth.uid])
        && next().teams[request.auth.uid] in [0, 1];

      // Revancha: un invitado la rechaza agregándose a declinedIds.
      allow update: if signedIn()
        && comp().status == 'lobby'
        && request.auth.uid in comp().get('invitedIds', [])
        && onlyChanged(['declinedIds'])
        && next().declinedIds.toSet() == comp().get('declinedIds', []).toSet().union([request.auth.uid].toSet());

      allow delete: if isUser(comp().hostId) && comp().status == 'lobby';

      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if isUser(uid)
          && request.auth.uid in getAfter(/databases/$(database)/documents/competitions/$(competitionId)).data.participantIds
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'score', 'solvedIds', 'hintsByClue', 'hintsUsed',
               'attempts', 'wrongAttempts', 'lastSolvedAt', 'lastAttemptAt', 'joinedAt', 'device'])
          && request.resource.data.uid == uid
          // Nombre real: el del perfil, no uno inventado.
          && request.resource.data.displayName == get(/databases/$(database)/documents/users/$(uid)).data.displayName
          && request.resource.data.score == 0
          && request.resource.data.solvedIds == []
          && request.resource.data.hintsUsed == 0
          && request.resource.data.attempts == 0
          && request.resource.data.wrongAttempts == 0;
        // Salir del lobby, o borrar la competencia entera (anfitrión) en el mismo batch.
        allow delete: if isUser(uid)
          && (!existsAfter(/databases/$(database)/documents/competitions/$(competitionId))
              || !(request.auth.uid in getAfter(/databases/$(database)/documents/competitions/$(competitionId)).data.participantIds));
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        // Participante de la sala dueña del chat, o (revancha) de una sala `viaId` que usa este chat.
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && validText(request.resource.data.text)
          && (request.auth.uid in get(/databases/$(database)/documents/competitions/$(competitionId)).data.participantIds
              || (request.resource.data.get('viaId', '') is string
                  && request.resource.data.get('viaId', '') != ''
                  && get(/databases/$(database)/documents/competitions/$(request.resource.data.viaId)).data.get('chatId', '') == competitionId
                  && request.auth.uid in get(/databases/$(database)/documents/competitions/$(request.resource.data.viaId)).data.participantIds));
        allow update, delete: if false;
      }
    }

    // ---------- Amistades ----------
    // id = pairId(a, b). status: pending -> accepted.
    match /friendRequests/{requestId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && requestId == pairId(request.resource.data.from, request.resource.data.to)
        && request.resource.data.status == 'pending'
        && request.resource.data.members.toSet() == [request.resource.data.from, request.resource.data.to].toSet()
        && request.resource.data.members.size() == 2;
      allow update: if isUser(resource.data.to)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && onlyChanged(['status', 'acceptedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---------- Chat ----------
    // chatId = 'global' o pairId de dos amigos.
    match /chats/{chatId}/messages/{messageId} {
      function canAccess() {
        return chatId == 'global'
          || (request.auth.uid in chatId.split('_')
              && get(/databases/$(database)/documents/friendRequests/$(chatId)).data.status == 'accepted');
      }
      allow read: if signedIn() && canAccess();
      allow create: if signedIn() && canAccess()
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.text);
      allow update, delete: if false;
    }

    // ---------- Cartiludus ----------
    // Bloque para `firestore.rules` de CRYPTICUS (dentro de `match /databases/{database}/documents`).
    // Desplegar desde CRYPTICUS: npx firebase-tools deploy --only firestore:rules --project crypticus-eh
    // Usa `isUser(uid)`, ya definido en ese archivo.
    //
    // Modelo de escritura: por partida (uno o varios problemas), 1 transacción que
    //   1) crea  pq_sessions/{uid}/items/{sessionId}
    //   2) crea/actualiza pq_users/{uid} (agregados), con lastSessionId = sessionId y played + 1.
    // Nada se escribe por paso. Sin servidor: las reglas limitan forma y rango, no la veracidad del puntaje.

    function pqCategories() { return ['identificarVA', 'distribucion', 'propiedad', 'calculo']; }

    // { identificarVA: {steps, firstTry, score}, ... } con enteros acotados.
    function pqCatStats(m, maxSteps) {
      return m is map && m.keys().hasOnly(pqCategories())
        && pqCat(m, 'identificarVA', maxSteps) && pqCat(m, 'distribucion', maxSteps)
        && pqCat(m, 'propiedad', maxSteps) && pqCat(m, 'calculo', maxSteps);
    }
    function pqCat(m, k, maxSteps) {
      return !(k in m) || (
        m[k] is map && m[k].keys().hasOnly(['steps', 'firstTry', 'score'])
        && m[k].steps is int && m[k].steps >= 0 && m[k].steps <= maxSteps
        && m[k].firstTry is int && m[k].firstTry >= 0 && m[k].firstTry <= m[k].steps
        && m[k].score is int && m[k].score >= -3 * maxSteps && m[k].score <= m[k].steps
      );
    }

    match /pq_users/{uid} {
      allow read: if isUser(uid);
      allow create, update: if isUser(uid)
        && request.resource.data.keys().hasOnly(['played', 'score', 'steps', 'firstTry', 'byCategory', 'byTopic', 'review', 'lastSessionId', 'updatedAt'])
        && request.resource.data.played == (resource == null ? 0 : resource.data.played) + 1
        && request.resource.data.score is int
        && request.resource.data.steps is int && request.resource.data.steps >= 0
        && request.resource.data.firstTry is int && request.resource.data.firstTry >= 0
        && request.resource.data.firstTry <= request.resource.data.steps
        && pqCatStats(request.resource.data.byCategory, 1000000)
        && request.resource.data.byTopic is map && request.resource.data.byTopic.size() <= 100
        && request.resource.data.review is map && request.resource.data.review.size() <= 500
        && request.resource.data.updatedAt == request.time
        // La partida se crea en la misma transacción.
        && !exists(/databases/$(database)/documents/pq_sessions/$(uid)/items/$(request.resource.data.lastSessionId))
        && existsAfter(/databases/$(database)/documents/pq_sessions/$(uid)/items/$(request.resource.data.lastSessionId));
      allow delete: if false;
    }

    match /pq_sessions/{uid}/items/{sessionId} {
      allow read: if isUser(uid);
      allow create: if isUser(uid)
        && sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && request.resource.data.keys().hasOnly(['subject', 'topics', 'config', 'problems', 'score', 'steps', 'firstTry', 'byCategory', 'hintsUsed', 'timeouts', 'startedAt', 'finishedAt'])
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 40
        && request.resource.data.topics is list && request.resource.data.topics.size() <= 30
        && request.resource.data.config is map && request.resource.data.config.keys().hasOnly(['count', 'stepLimit', 'totalMin', 'mode'])
        && request.resource.data.problems is list && request.resource.data.problems.size() >= 1 && request.resource.data.problems.size() <= 20
        && request.resource.data.steps is int && request.resource.data.steps >= 1 && request.resource.data.steps <= 200
        && request.resource.data.firstTry is int && request.resource.data.firstTry >= 0
        && request.resource.data.firstTry <= request.resource.data.steps
        // +1 por paso como máximo; −3 por paso como mínimo.
        && request.resource.data.score is int
        && request.resource.data.score <= request.resource.data.steps
        && request.resource.data.score >= -3 * request.resource.data.steps
        && request.resource.data.hintsUsed is int && request.resource.data.hintsUsed >= 0
        && request.resource.data.hintsUsed <= request.resource.data.steps
        && request.resource.data.timeouts is int && request.resource.data.timeouts >= 0
        && request.resource.data.timeouts <= request.resource.data.steps
        && pqCatStats(request.resource.data.byCategory, request.resource.data.steps)
        && request.resource.data.startedAt is timestamp && request.resource.data.startedAt <= request.time
        && request.resource.data.finishedAt == request.time
        // Va con la actualización de agregados en la misma transacción.
        && getAfter(/databases/$(database)/documents/pq_users/$(uid)).data.lastSessionId == sessionId;
      allow update, delete: if false;
    }
  }
}
