{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crypticus",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Solo /api/* invoca el Worker; el resto son assets gratuitos e ilimitados.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "COMPETITION_ROOM", "class_name": "CompetitionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CompetitionRoom"] }],
  "vars": {
    // Id del proyecto Firebase (público).
    "FIREBASE_PROJECT_ID": "crypticus-eh"
  }
  // Secrets (no van aquí): `wrangler secret put FIREBASE_SERVICE_ACCOUNT` y `wrangler secret put ANSWER_HMAC_KEY`
}
