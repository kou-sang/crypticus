# --- Cliente (públicas, se exponen en el bundle) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Script de importación (local) ---
# JSON de la cuenta de servicio en una sola línea, o en base64.
FIREBASE_SERVICE_ACCOUNT=
# Misma clave que el secret del Worker. Genera una con: openssl rand -hex 32
ANSWER_HMAC_KEY=

# --- Worker ---
# En local: copia FIREBASE_SERVICE_ACCOUNT y ANSWER_HMAC_KEY a .dev.vars
# En producción: wrangler secret put FIREBASE_SERVICE_ACCOUNT / ANSWER_HMAC_KEY
