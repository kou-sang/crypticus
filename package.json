{
  "name": "crypticus",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de competencias de cripticos en tiempo real (variante Cloudflare Workers + Durable Objects).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:cryptics": "tsx scripts/import-cryptics.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "prebuild": "node scripts/ensure-secrets.mjs",
    "pretypecheck": "node scripts/ensure-secrets.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:secrets": "wrangler secret put FIREBASE_SERVICE_ACCOUNT && wrangler secret put ANSWER_HMAC_KEY"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "firebase": "^12.0.0",
    "jose": "^6.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.4.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
